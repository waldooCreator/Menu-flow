{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "8001",
        "--noreload"
      ],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180,
      "env": {
        "BACKEND_URL": "http://127.0.0.1:8001"
      }
    },
    {
      "name": "backend-estres",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "8002",
        "--noreload"
      ],
      "port": 8002,
      "env": {
        "DB_NAME": "terra_estres"
      }
    }
  ]
}