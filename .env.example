# Copiar a .env y ajustar. Nunca versionar el .env real.
#
# Cada instancia futura (un restaurante = una base + una carpeta de medios +
# un puerto propio, SPEC-009) tiene su propio .env con estos mismos nombres
# de variable y valores distintos — eso es lo que permite que convivan en el
# mismo VPS.

# --- Base de datos ---
DB_NAME=terra
DB_USER=terra
DB_PASSWORD=cambiar_en_local
DB_HOST=localhost
DB_PORT=5433

# --- Django ---
DJANGO_SECRET_KEY=clave-de-desarrollo-cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Superusuario inicial (solo para el comando de arranque local) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@terra.local
DJANGO_SUPERUSER_PASSWORD=cambiar_en_local

# --- Medios (imágenes subidas: hero, galería, platos) ---
# Ruta relativa al proyecto. En el VPS, cada instancia apunta a su propia
# carpeta para no mezclar archivos entre restaurantes.
MEDIA_ROOT=media
MEDIA_URL=/media/

# --- Puerto del sitio (distinto por instancia en el VPS) ---
SITE_PORT=8000

# --- Vue: origenes permitidos por CORS (separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
